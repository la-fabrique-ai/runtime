#!/usr/bin/env node
// forge-team : la façon dont un exécuteur parle à forge. Une requête JSON sur
// une ligne vers la socket de l'API de l'hôte, une réponse sur une ligne ;
// l'hôte sait qui appelle par la socket, pas par ce que ce script dit. Aucune
// dépendance. Un texte (une question, un compte rendu) arrive par stdin ou par
// un fichier, jamais par un argument.
//
//   forge-team ask                      une question précise (sur stdin) ; la réponse arrive dans ton terminal
//   forge-team done [--wip] [--report-file <fichier>]
//                                       ta mission est faite et commitée (--wip : un travail en cours
//                                       rendu, la question attend l'humain) ; le compte rendu est gardé
//   forge-team status                   la mission que tu tiens, ou aucune
//
// Sorties : 0 accepté ; 1 refusé par l'API (la raison sur stderr) ; 2 socket
// injoignable ; 64 mauvais usage.
"use strict";
const fs = require("node:fs");
const net = require("node:net");

const SOCKET = process.env.FORGE_API_SOCKET || "/var/lib/forge/api.sock";
const USAGE = `usage: forge-team ask                (the question on stdin)
       forge-team done [--wip] [--report-file <file>]
       forge-team status`;

function usage(message) {
  process.stderr.write(`forge-team: ${message}\n${USAGE}\n`);
  process.exit(64);
}

// Tout stdin, ses sauts de ligne finaux retirés ; un terminal n'est pas un texte.
function readStdin(what) {
  if (process.stdin.isTTY) usage(`${what} is read from stdin, not from a terminal`);
  let text;
  try {
    text = fs.readFileSync(0, "utf8");
  } catch {
    usage(`cannot read the ${what} from stdin`);
  }
  text = text.replace(/\n+$/, "");
  if (text.trim() === "") usage(`the ${what} on stdin is empty`);
  return text;
}

function request() {
  const [command, ...args] = process.argv.slice(2);
  switch (command) {
    case "status":
      if (args.length > 0) usage("status takes no argument");
      return { op: "status" };
    case "ask":
      if (args.length > 0) usage("ask takes no argument: the question is read from stdin");
      return { op: "ask", text: readStdin("question") };
    case "done": {
      let wip = false;
      let report = null;
      for (let i = 0; i < args.length; i++) {
        if (args[i] === "--wip" && !wip) {
          wip = true;
        } else if (args[i] === "--report-file" && report === null && args[i + 1] !== undefined) {
          const file = args[++i];
          try {
            report = fs.readFileSync(file, "utf8");
          } catch (e) {
            usage(`cannot read the report file ${file}: ${e.code || e.message}`);
          }
        } else {
          usage(`done: unexpected argument ${args[i]}`);
        }
      }
      return { op: "done", wip, report };
    }
    default:
      usage(command === undefined ? "a command is required" : `unknown command ${command}`);
  }
}

// La requête part sans fermer l'écriture : le device proxy d'Incus prend la fin
// du flux d'un côté pour la fin de la connexion, et la réponse serait perdue.
// La réponse est une ligne, que l'on attend jusqu'à son saut de ligne.
function call(req) {
  return new Promise((resolve) => {
    const socket = net.connect(SOCKET);
    let out = "";
    socket.setEncoding("utf8");
    socket.on("connect", () => socket.write(`${JSON.stringify(req)}\n`));
    socket.on("data", (chunk) => {
      out += chunk;
      if (out.includes("\n")) socket.destroy();
    });
    socket.on("error", (e) => {
      process.stderr.write(`forge-team: cannot reach the forge API at ${SOCKET}: ${e.code || e.message}\n`);
      process.exit(2);
    });
    socket.on("close", () => resolve(out));
  });
}

(async () => {
  const req = request();
  const out = await call(req);
  // Une connexion fermée sans réponse ne dit pas que la demande a échoué : elle a
  // pu aboutir. La refaire à l'aveugle donnerait un doublon.
  if (out === "") {
    process.stderr.write("forge-team: no answer from the forge API: the request may have been carried out; " +
      "check forge-team status before trying again\n");
    process.exit(2);
  }
  let reply;
  try {
    reply = JSON.parse(out.split("\n")[0]);
  } catch {
    process.stderr.write("forge-team: the forge API sent an answer that is not JSON\n");
    process.exit(2);
  }
  if (!reply.ok) {
    process.stderr.write(`forge-team: ${reply.error}\n`);
    process.exit(1);
  }
  if (req.op === "status" && "mission" in reply) {
    const m = reply.mission;
    process.stdout.write(m === null ? "ok\nmission: none\n"
      : `ok\nmission: ${m.subtask} ticket=${m.ticket} repository=${m.repository} branch=${m.branch} base=${m.base}\n`);
  } else if (req.op === "status" && Array.isArray(reply.executors)) {
    // La réponse du contrôle : une ligne par exécuteur.
    process.stdout.write("ok\n");
    for (const e of reply.executors) {
      process.stdout.write(`${e.name} session=${e.session} mission=${e.mission === null ? "none" : e.mission.subtask}\n`);
    }
  } else if (req.op === "ask") {
    process.stdout.write(`ok ${reply.id}\nyour question is recorded: go on with what does not depend on it; ` +
      "the answer arrives in this terminal\n");
  } else {
    process.stdout.write(`ok${typeof reply.id === "number" ? ` ${reply.id}` : ""}\n`);
  }
})();
