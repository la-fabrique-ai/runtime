#!/usr/bin/env node
// forge-team : la façon dont un agent parle à forge. Une requête JSON sur une
// ligne vers une socket, une réponse sur une ligne ; celui qui reçoit sait qui
// appelle par la socket, pas par ce que ce script dit. Aucune dépendance. Un
// texte (une question, un compte rendu, une spec) arrive par stdin ou par un
// fichier, jamais par un argument.
//
// Dans le container de contrôle (la socket du canal local de l'orchestrateur
// existe), seulement les commandes du canal : lire les tickets, écrire leurs
// fichiers de mission et leur pile, répondre, créer les correctifs d'une revue
// et ses tickets non bloquants (voir CONTROL_USAGE). Ailleurs,
// celles d'un exécuteur, vers l'API de l'hôte :
//
//   forge-team done [--report-file <fichier>] [--qa-report-file <fichier>]
//                                       ta mission est faite et commitée ; le compte rendu est gardé ;
//                                       une QA rend son compte rendu structuré (JSON) par le second
//   forge-team ask [--recommended-file <fichier>]
//                                       une question pour l'humain (sur stdin) : ton travail en cours,
//                                       commité, est rendu, et ce container va être libéré
//   forge-team status                   la mission que tu tiens, ou aucune
//
// Sorties : 0 accepté ; 1 refusé (la raison sur stderr) ; 2 socket injoignable ;
// 64 mauvais usage.
"use strict";
const fs = require("node:fs");
const net = require("node:net");

const API_SOCKET = process.env.FORGE_API_SOCKET || "/var/lib/forge/api.sock";
const CHANNEL_SOCKET = process.env.FORGE_CHANNEL_SOCKET || "/run/forge-orch/channel.sock";
const CONTROL = fs.existsSync(CHANNEL_SOCKET);
const SOCKET = CONTROL ? CHANNEL_SOCKET : API_SOCKET;
const EXECUTOR_USAGE = `usage: forge-team done [--report-file <file>] [--qa-report-file <file>]
       forge-team ask [--recommended-file <file>]   (the question for the human on stdin)
       forge-team status`;
const CONTROL_USAGE = `usage: forge-team tickets [--json] [<status>…]
       forge-team ticket <id>
       forge-team mission <id> <spec|answers|split>
       forge-team problems [--json]
       forge-team open <id>
       forge-team write-mission <id> <spec|answers|split>   (the text on stdin)
       forge-team create-stack <id>                         (a JSON array of {repository, text} on stdin)
       forge-team answer-request <id> <n>                   (the answer on stdin)
       forge-team comment <id>                              (the text on stdin)
       forge-team create-fixes <id>                         (a JSON array of {fixes, text} on stdin)
       forge-team create-ticket <from>                      (a JSON object {title, text} on stdin)`;
const USAGE = CONTROL ? CONTROL_USAGE : EXECUTOR_USAGE;

function usage(message) {
  process.stderr.write(`forge-team: ${message}\n${USAGE}\n`);
  process.exit(64);
}

function readFile(file, what) {
  try {
    return fs.readFileSync(file, "utf8");
  } catch (e) {
    usage(`cannot read the ${what} ${file}: ${e.code || e.message}`);
  }
}

const FILES = ["spec", "answers", "split"];

// Les commandes du container de contrôle : chacune, sa requête au canal.
function controlRequest(command, args) {
  const exactly = (n, shape) => {
    if (args.length !== n) usage(`${command} takes ${shape}`);
  };
  switch (command) {
    case "tickets": {
      const statuses = args.filter((a) => a !== "--json");
      return statuses.length === 0 ? { op: "tickets" } : { op: "tickets", status: statuses };
    }
    case "ticket":
      exactly(1, "a ticket id");
      return { op: "ticket", id: args[0] };
    case "mission":
      exactly(2, "a ticket id and spec, answers or split");
      if (!FILES.includes(args[1])) usage("the file is spec, answers or split");
      return { op: "mission", id: args[0], file: args[1] };
    case "problems":
      if (args.length > 1 || (args.length === 1 && args[0] !== "--json")) usage("problems takes only --json");
      return { op: "problems" };
    case "open":
      exactly(1, "a ticket id");
      return { op: "open", id: args[0] };
    case "write-mission":
      exactly(2, "a ticket id and spec, answers or split");
      if (!FILES.includes(args[1])) usage("the file is spec, answers or split");
      return { op: "write-mission", id: args[0], file: args[1], text: readStdin("text") };
    case "create-stack": {
      exactly(1, "a ticket id");
      let subtasks;
      try {
        subtasks = JSON.parse(readStdin("list of sub-tasks"));
      } catch {
        usage("create-stack reads a JSON array of {repository, text} on stdin");
      }
      if (!Array.isArray(subtasks)) usage("create-stack reads a JSON array of {repository, text} on stdin");
      return { op: "create-stack", id: args[0], subtasks };
    }
    case "answer-request":
      exactly(2, "a ticket id and a request number");
      return { op: "answer-request", id: args[0], request: args[1], text: readStdin("answer") };
    case "comment":
      exactly(1, "a ticket id");
      return { op: "comment", id: args[0], text: readStdin("text") };
    case "create-fixes": {
      exactly(1, "a ticket id");
      const shape = "create-fixes reads a JSON array of {fixes, text} on stdin";
      let fixes;
      try {
        fixes = JSON.parse(readStdin("list of fixes"));
      } catch {
        usage(shape);
      }
      if (!Array.isArray(fixes)) usage(shape);
      return { op: "create-fixes", id: args[0], fixes };
    }
    case "create-ticket": {
      exactly(1, "the id of the ticket it comes from");
      const shape = "create-ticket reads a JSON object {title, text} on stdin";
      let t;
      try {
        t = JSON.parse(readStdin("new ticket"));
      } catch {
        usage(shape);
      }
      if (typeof t !== "object" || t === null || Array.isArray(t)) usage(shape);
      return { op: "create-ticket", from: args[0], title: t.title, text: t.text };
    }
    default:
      usage(command === undefined ? "a command is required" : `unknown command ${command}`);
  }
}

// Tout stdin, ses sauts de ligne finaux retirés (\r compris) ; un terminal n'est pas un texte.
function readStdin(what) {
  if (process.stdin.isTTY) usage(`${what} is read from stdin, not from a terminal`);
  let text;
  try {
    text = fs.readFileSync(0, "utf8");
  } catch {
    usage(`cannot read the ${what} from stdin`);
  }
  text = text.replace(/[\r\n]+$/, "");
  if (text.trim() === "") usage(`the ${what} on stdin is empty`);
  return text;
}

function request() {
  const [command, ...args] = process.argv.slice(2);
  if (CONTROL) return controlRequest(command, args);
  switch (command) {
    case "status":
      if (args.length > 0) usage("status takes no argument");
      return { op: "status" };
    case "ask": {
      let recommended = null;
      if (args.length === 2 && args[0] === "--recommended-file") {
        recommended = readFile(args[1], "recommended answer file").replace(/[\r\n]+$/, "");
      } else if (args.length > 0) {
        usage("ask takes only --recommended-file <file>: the question is read from stdin");
      }
      return { op: "ask", text: readStdin("question"), recommended };
    }
    case "done": {
      let report = null;
      let qa;
      for (let i = 0; i < args.length; i++) {
        if (args[i] === "--report-file" && report === null && args[i + 1] !== undefined) {
          report = readFile(args[++i], "report file");
        } else if (args[i] === "--qa-report-file" && qa === undefined && args[i + 1] !== undefined) {
          const file = args[++i];
          const text = readFile(file, "QA report file");
          try {
            qa = JSON.parse(text);
          } catch {
            usage(`done: the --qa-report-file ${file} is not JSON`);
          }
        } else {
          usage(`done: unexpected argument ${args[i]}`);
        }
      }
      // Sans compte rendu de QA, la requête de la partie 2, telle quelle.
      return qa === undefined ? { op: "done", report } : { op: "done", report, qa };
    }
    default:
      usage(command === undefined ? "a command is required" : `unknown command ${command}`);
  }
}

// La requête part sans fermer l'écriture : le device proxy d'Incus prend la fin
// du flux d'un côté pour la fin de la connexion, et la réponse serait perdue.
// La réponse est une ligne, que l'on attend jusqu'à son saut de ligne.
function call(req) {
  return new Promise((resolve) => {
    const socket = net.connect(SOCKET);
    let out = "";
    socket.setEncoding("utf8");
    socket.on("connect", () => socket.write(`${JSON.stringify(req)}\n`));
    socket.on("data", (chunk) => {
      out += chunk;
      if (out.includes("\n")) socket.destroy();
    });
    socket.on("error", (e) => {
      const what = CONTROL ? "the orchestrator's channel" : "the forge API";
      process.stderr.write(`forge-team: cannot reach ${what} at ${SOCKET}: ${e.code || e.message}\n`);
      process.exit(2);
    });
    socket.on("close", () => resolve(out));
  });
}

// Ce que le canal rend, pour un humain ou un agent qui le lit.
function printControl(req, reply) {
  const w = (s) => process.stdout.write(`${s}\n`);
  switch (req.op) {
    case "tickets":
      if (process.argv.includes("--json")) return w(JSON.stringify(reply.tickets));
      for (const t of reply.tickets) w(`${t.id}\t${t.status}\tP${t.priority}\t${t.title}${t.waiting > 0 ? `\t(waits for ${t.waiting})` : ""}`);
      for (const p of reply.problems) w(`problem: ${p}`);
      return;
    case "ticket": {
      const t = reply.ticket;
      w(`${t.id} [${t.status}] P${t.priority} ${t.title}`);
      w(`repositories: ${t.repositories.map((r) => `${r.name} (base ${r.base})`).join(", ")}`);
      w("");
      w(t.description);
      w("");
      w("## Sub-tasks");
      for (const s of reply.subtasks) {
        w(`${s.id} ${s.repository} #${s.position} [${s.status}]${s.branch ? ` ${s.branch}` : ""}`);
        w(s.text);
        w("");
      }
      w("## Requests");
      for (const r of reply.requests) {
        w(`request ${r.id} on ${r.subtask}: ${r.answer === null ? "WAITING" : "answered"}`);
        w(r.text);
        if (r.recommended !== null) w(`recommended: ${r.recommended}`);
        if (r.answer !== null) w(`answer: ${r.answer}`);
        w("");
      }
      w("## Comments");
      for (const c of reply.comments) {
        w(`${c.id} ${c.author} (${c.kind}, ${c.at})`);
        w(c.text);
        w("");
      }
      return;
    }
    case "mission": {
      const text = reply.mission[req.file];
      if (text === null) {
        process.stderr.write("(none)\n");
        process.exit(1);
      }
      process.stdout.write(text);
      return;
    }
    case "problems":
      if (process.argv.includes("--json")) w(JSON.stringify(reply.problems));
      else for (const p of reply.problems) w(p);
      return;
    case "create-stack":
    case "create-fixes":
      w(`ok ${reply.subtasks.join(" ")}`);
      return;
    case "create-ticket":
      w(`ok ${reply.id}`);
      return;
    default:
      w("ok");
  }
}

(async () => {
  const raw = request();
  // `mission` demande un fichier : le canal rend les trois.
  const req = raw.op === "mission" ? { op: "mission", id: raw.id } : raw;
  const out = await call(req);
  // Une connexion fermée sans réponse ne dit pas que la demande a échoué : elle a
  // pu aboutir. La refaire à l'aveugle donnerait un doublon.
  if (out === "") {
    process.stderr.write("forge-team: no answer from the forge API: the request may have been carried out; " +
      "check forge-team status before trying again\n");
    process.exit(2);
  }
  let reply;
  try {
    reply = JSON.parse(out.split("\n")[0]);
  } catch {
    process.stderr.write("forge-team: the forge API sent an answer that is not JSON\n");
    process.exit(2);
  }
  if (!reply.ok) {
    process.stderr.write(`forge-team: ${reply.error}\n`);
    process.exit(1);
  }
  if (CONTROL) return printControl(raw, reply);
  if (req.op === "status" && "mission" in reply) {
    const m = reply.mission;
    // Une mission dev se lit comme avant ; une autre dit son genre.
    process.stdout.write(m === null ? "ok\nmission: none\n"
      : m.kind === "dev" ? `ok\nmission: ${m.subtask} ticket=${m.ticket} repository=${m.repository} branch=${m.branch} base=${m.base}\n`
        : `ok\nmission: ${m.kind} ${m.kind === "qa" ? m.ticket : m.subtask} (${m.repository}) branch=${m.branch} base=${m.base}\n`);
  } else if (req.op === "status" && Array.isArray(reply.executors)) {
    // La réponse du contrôle : une ligne par exécuteur.
    process.stdout.write("ok\n");
    for (const e of reply.executors) {
      process.stdout.write(`${e.name} session=${e.session} mission=${e.mission === null ? "none" : e.mission.subtask}\n`);
    }
  } else if (req.op === "ask") {
    process.stdout.write(`ok ${reply.id}\nyour question goes to the human, with your work in progress: ` +
      "this container is about to be released; the sub-task resumes later, with the answer\n");
  } else {
    process.stdout.write(`ok${typeof reply.id === "number" ? ` ${reply.id}` : ""}\n`);
  }
})();
